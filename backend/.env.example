# App database (PostgreSQL)
DATABASE_URL=postgresql://user:password@localhost:5432/intelliquery

# Key used to encrypt stored connection credentials
ENCRYPTION_KEY=

# Set to false once the schema exists — skips table creation/migration checks
# on startup, which cuts several seconds off every boot/cold start
RUN_STARTUP_MIGRATIONS=true

# LLM providers — OpenAI is primary, Gemini is the fallback
OPENAI_API_KEY=
GEMINI_API_KEY=

# Optional overrides (defaults shown)
# OPENAI_MODEL=gpt-4o-mini
# GEMINI_MODEL=gemini-2.5-flash
# LLM_FALLBACK_ORDER=openai,gemini
# WHISPER_MODEL=whisper-1

# Outgoing email (team invites). Leave SMTP_HOST empty in dev to log links instead of sending.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=Intelliquery <shaikhaman.0020@gmail.com>

# Where invite links point (the Next.js app)
FRONTEND_URL=http://localhost:3000
